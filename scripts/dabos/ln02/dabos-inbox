#!/usr/bin/env bash
# RR-010 step 1: `dabos-inbox send ...` on ln02 (wraps scripts/dabos/dabos-inbox.ts).
# Prints the INSERT for the Neon tool unless DABOS_INBOX_DATABASE_URL is set in the caller's env.
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
exec "$REPO/node_modules/.bin/tsx" "$REPO/scripts/dabos/dabos-inbox.ts" "$@"
