# ~/.config/dabos/comm-center.env (mode 600) — Logan places values; never commit secrets.
# Timezone + clocks: see clocks.env.example (COMM_CLOCK_* / COMM_TZ).

COMM_TZ=Europe/Berlin
COMM_CENTER_DATABASE_URL=

# Shared with wake-if-new (same header contract)
WAKE_KEY_HEADER=Authorization
WAKE_KEY_SCHEME=Bearer

# Per-post Grok routine webhooks (one routine per post, converted to webhook trigger)
WAKE_DIV1_URL=
WAKE_DIV1_KEY=
WAKE_DIV2_URL=
WAKE_DIV2_KEY=
WAKE_DIV3_URL=
WAKE_DIV3_KEY=
WAKE_DIV4_URL=
WAKE_DIV4_KEY=
WAKE_DIV5_URL=
WAKE_DIV5_KEY=
WAKE_DIV6_URL=
WAKE_DIV6_KEY=
WAKE_DIV7_URL=
WAKE_DIV7_KEY=
WAKE_LDW_URL=
WAKE_LDW_KEY=

# Optional overrides
# WAKE_ERROR_WAKE_AFTER=2
# WAKE_HTTP_TIMEOUT=30
# CC_DRY_RUN=0
