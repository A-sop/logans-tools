# Pick-up clocks (Europe/Berlin). Courier runs 1 minute before each slot.
# Copied/merged into ~/.config/dabos/comm-center.env by Logan (mode 600).
# Do not hardcode these in scripts — the runner sources this file.
#
# Format: COMM_CLOCK_<POST>=HH:MM[,HH:MM...][;dow=...]
#   dow optional: mon-fri | sat-sun | thu | daily (default daily)
# Multiple lines per post are allowed (merged).

COMM_TZ=Europe/Berlin

# Div1 — 08:00, 13:00, 18:00 daily + Thu 14:45
COMM_CLOCK_DIV1=08:00,13:00,18:00;dow=daily
COMM_CLOCK_DIV1_THU=14:45;dow=thu

# LDW — 08:15, 20:50 daily
COMM_CLOCK_LDW=08:15,20:50;dow=daily

# Div2, Div3, Div6 — 09:15, 15:30 daily (Div3's own 10th/25th jobs stay untouched)
COMM_CLOCK_DIV2=09:15,15:30;dow=daily
COMM_CLOCK_DIV3=09:15,15:30;dow=daily
COMM_CLOCK_DIV6=09:15,15:30;dow=daily

# Div4 — Mon–Fri 09:00,13:30,17:30; Sat–Sun 09:00,17:30
COMM_CLOCK_DIV4_WD=09:00,13:30,17:30;dow=mon-fri
COMM_CLOCK_DIV4_WE=09:00,17:30;dow=sat-sun

# Div5 — Mon–Fri 10:30,15:00,19:00; Sat–Sun 10:30,19:00
COMM_CLOCK_DIV5_WD=10:30,15:00,19:00;dow=mon-fri
COMM_CLOCK_DIV5_WE=10:30,19:00;dow=sat-sun

# Div7 — 08:30, 16:30 daily + Thu 21:05
COMM_CLOCK_DIV7=08:30,16:30;dow=daily
COMM_CLOCK_DIV7_THU=21:05;dow=thu

# Logan digest build (no agent wake) — 20:45
COMM_CLOCK_DIGEST=20:45;dow=daily

# Leave fixed Thu 14:00 / 14:30 stat scripts untouched (not listed here).
