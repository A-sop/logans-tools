# Copy to ~/.config/dabos/wake-if-new.env and chmod 600.
# Fill VALUES locally — this file in git lists NAMES only.

# Webhook auth (defaults shown). Change if the Grok routine panel documents otherwise.
# WAKE_KEY_HEADER=Authorization
# WAKE_KEY_SCHEME=Bearer

# --- telegram_triage ---
WAKE_TELEGRAM_TRIAGE_URL=
WAKE_TELEGRAM_TRIAGE_KEY=
WAKE_TELEGRAM_TRIAGE_DATABASE_URL=

# --- mail_triage (Migadu IMAP; same mailbox as MAIL_TRIAGE_IMAP_*) ---
WAKE_MAIL_TRIAGE_URL=
WAKE_MAIL_TRIAGE_KEY=
WAKE_MAIL_IMAP_HOST=imap.migadu.com
WAKE_MAIL_IMAP_PORT=993
WAKE_MAIL_IMAP_FOLDER=INBOX
WAKE_MAIL_IMAP_USER=mail@loganwilliams.com
WAKE_MAIL_IMAP_PASSWORD=

# --- status_div1 .. status_div7 ---
WAKE_STATUS_DIV1_URL=
WAKE_STATUS_DIV1_KEY=
WAKE_STATUS_DIV2_URL=
WAKE_STATUS_DIV2_KEY=
WAKE_STATUS_DIV3_URL=
WAKE_STATUS_DIV3_KEY=
WAKE_STATUS_DIV4_URL=
WAKE_STATUS_DIV4_KEY=
WAKE_STATUS_DIV5_URL=
WAKE_STATUS_DIV5_KEY=
WAKE_STATUS_DIV6_URL=
WAKE_STATUS_DIV6_KEY=
WAKE_STATUS_DIV7_URL=
WAKE_STATUS_DIV7_KEY=
WAKE_STATUS_DATABASE_URL=
WAKE_GITHUB_TOKEN=

# --- morning_brief ---
WAKE_MORNING_BRIEF_URL=
WAKE_MORNING_BRIEF_KEY=

# Shared read-only Neon URL (optional fallback for telegram + status)
# WAKE_DATABASE_URL=
