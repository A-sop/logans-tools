# Placeholder morning Berlin — confirm against Grok routine panel before cutover.
[Unit]
Description=DABOS wake-if-new morning brief timer (07:00 Berlin)

[Timer]
OnCalendar=*-*-* 07:00:00 Europe/Berlin
Persistent=true
AccuracySec=1min
Unit=dabos-wake-morning-brief.service

[Install]
WantedBy=timers.target
